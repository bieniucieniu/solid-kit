    "@kobalte/core": "^0.13.14",
    "@shikijs/core": "^4.5.0",
    "@shikijs/engine-javascript": "^4.5.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "clsx": "^2.1.1",
